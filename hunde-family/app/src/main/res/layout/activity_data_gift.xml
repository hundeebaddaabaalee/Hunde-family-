<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 Paakeejii Dataa Ergi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Maatii Filadhu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maatii keessaa filadhu:"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="12dp" />

            <!-- Horizontal Quick Select (Maatii) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Member 1 -->
                    <LinearLayout
                        android:id="@+id/btnFamily1"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_family_chip"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👨"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Obbo Caalaa"
                            android:textSize="12sp"
                            android:textColor="#1F2937"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Member 2 -->
                    <LinearLayout
                        android:id="@+id/btnFamily2"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_family_chip"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👩"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aaddee"
                            android:textSize="12sp"
                            android:textColor="#1F2937"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Member 3 -->
                    <LinearLayout
                        android:id="@+id/btnFamily3"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_family_chip">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👦"
                            android:textSize="24sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Obboleessa"
                            android:textSize="12sp"
                            android:textColor="#1F2937"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Card 2: Details & Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="16dp">

            <!-- Lakkoofsa Bilbilaa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lakkoofsa Bilbilaa:"
                android:textColor="#374151"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="09XXXXXXXX"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp" />

            <!-- Paakeejii Filadhu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paakeejii Filadhu:"
                android:textColor="#374151"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerPackages"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp" />

            <!-- Gatii Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gatii Waliigalaa:"
                    android:textSize="16sp"
                    android:textColor="#4B5563" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 ETB"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#6D28D9" />
            </LinearLayout>

        </LinearLayout>

        <!-- Send Button -->
        <Button
            android:id="@+id/btnSendGift"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🎁 DATA ERGI"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6D28D9" />

    </LinearLayout>
</ScrollView>