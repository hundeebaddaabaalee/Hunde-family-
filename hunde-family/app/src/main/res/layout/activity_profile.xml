<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Koo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Suura Profile -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="#6200EE"
                android:padding="16dp"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/ivProfilePicture"
                android:layout_centerHorizontal="true"
                android:text="Jijjiiri"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#80000000"
                android:padding="2dp" />
        </RelativeLayout>

        <!-- Card Form Odeeffannoo Profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="20dp">

            <!-- Maqaa Guutuu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maqaa Guutuu"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Maqaa Guutuu"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username (unikii ta'uu qaba)"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teessoo Email"
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp" />

            <!-- Lakkoofsa Bilbilaa & Code Request -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lakkoofsa Bilbilaa"
                android:textColor="#888888"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="+254..."
                    android:inputType="phone" />

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code Ergi"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Koodii Mirkaneessaa OTP"
                android:inputType="number"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Password Change Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password Jijjiiruuf"
                android:textColor="#6200EE"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etOldPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password Duraanii"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password Haaraa"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Jijjiirama Ol-kaayi (Save)"
            android:backgroundTint="#6200EE"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Gara Home'tti Deebi'i"
            android:backgroundTint="#888888" />

    </LinearLayout>
</ScrollView>